rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'role', 'createdAt'])
        && data.keys().hasOnly(['id', 'role', 'createdAt', 'updatedAt', 'lastLoginAt', 'email', 'displayName', 'avatar', 'firstName', 'lastName', 'phoneNumber', 'address'])
        && data.id is string && data.id.size() <= 128
        && data.role in ['customer', 'admin']
        && data.createdAt is number
        && (!('updatedAt' in data) || data.updatedAt is number)
        && (!('lastLoginAt' in data) || data.lastLoginAt is number)
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 50))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 50))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30));
    }

    // User profile document rules
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.id == uid && isValidUserProfile(request.resource.data);
      allow update: if isOwner(uid) && resource.data.id == request.resource.data.id && resource.data.createdAt == request.resource.data.createdAt && isValidUserProfile(request.resource.data) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // User subcollections (cart, wishlist, orders, etc.)
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Passwordless / Phone OTP verification tracking
    match /otp_verifications/{otpId} {
      allow get: if true;
      allow list: if false;

      allow create: if isValidId(otpId)
        && request.resource.data.id == otpId
        && request.resource.data.type in ['phone', 'email']
        && request.resource.data.identifier is string
        && request.resource.data.identifier.size() <= 100
        && request.resource.data.expiresAt is number
        && request.resource.data.attempts is number
        && request.resource.data.attempts >= 0
        && request.resource.data.verified == false
        && request.resource.data.createdAt is number;

      allow update: if isValidId(otpId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.identifier == resource.data.identifier
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'verified', 'verifiedAt']);

      allow delete: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
